# 让源码扩展构建优先使用项目自己的 pixi 默认环境, 不要误探测宿主机 `/usr/local/cuda`.
export PIXI_DEFAULT_ENV="${PWD}/.pixi/envs/default"
export PIXI_CUDA_ROOT="${PIXI_DEFAULT_ENV}/targets/x86_64-linux"
export PIXI_CUDA_NVVM_BIN="${PIXI_DEFAULT_ENV}/nvvm/bin"

# 一些老的 setup.py / torch 扩展构建逻辑会直接读取 `CONDA_PREFIX`.
export CONDA_PREFIX="${PIXI_DEFAULT_ENV}"

# `torch.utils.cpp_extension` 会用 `CUDA_HOME/include` 和 `CUDA_HOME/lib`.
# pixi 当前的真实 toolkit 根在 `targets/x86_64-linux`, 不是环境根目录本身.
# 同时 `nvcc` 运行时还需要 `nvvm/bin` 里的 `cicc`, 所以 PATH 也要一起补。
export PATH="${PIXI_CUDA_NVVM_BIN}:${PIXI_CUDA_ROOT}/bin:${PIXI_DEFAULT_ENV}/bin:${PATH}"
export CUDA_HOME="${PIXI_CUDA_ROOT}"
export CUDA_PATH="${CUDA_HOME}"

# 如果 toolkit 已经把 CUB 头文件放进默认 include 目录, 就显式告诉旧版扩展去这里找.
if [ -d "${CUDA_HOME}/include/cub" ]; then
  export CUB_HOME="${CUDA_HOME}/include"
fi
